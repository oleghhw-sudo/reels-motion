{
  "$comment": "Манифест среды reels-motion. Всё внешнее, без чего проект не работает. Читает scripts/check-env.mjs (npm run check). Новая внешняя зависимость — сначала сюда.",
  "version": 1,
  "runtime": {
    "node": {
      "min": "22.6.0",
      "why": "ESM + запуск .ts тестов через --experimental-strip-types (npm run test:contrast)"
    }
  },
  "binaries": [
    {
      "name": "ffmpeg",
      "args": [
        "-version"
      ],
      "required_for": "render",
      "hint": "macOS: brew install ffmpeg"
    },
    {
      "name": "ffprobe",
      "args": [
        "-version"
      ],
      "required_for": "render",
      "hint": "ставится вместе с ffmpeg"
    }
  ],
  "npm": {
    "source": "package.json",
    "exact_versions": true,
    "hint": "npm install"
  },
  "remotion_browser": {
    "path": "node_modules/.remotion/chrome-headless-shell",
    "alt_env": "REMOTION_BROWSER_EXECUTABLE",
    "required_for": "render",
    "hint": "npx remotion browser ensure (или задать REMOTION_BROWSER_EXECUTABLE — путь к готовому chrome-headless-shell)"
  },
  "fonts": {
    "dir": "public/fonts",
    "registry": "src/theme/fonts.ts",
    "required_glyphs": "ґєіїʼҐЄІЇ",
    "license_file": "OFL.txt",
    "files": [
      "Unbounded/Unbounded-VF.ttf",
      "Onest/Onest-VF.ttf",
      "JetBrainsMono/JetBrainsMono-VF.ttf",
      "Rubik/Rubik-VF.ttf",
      "Inter/Inter-VF.ttf",
      "IBMPlexMono/IBMPlexMono-Regular.ttf",
      "PlayfairDisplay/PlayfairDisplay-VF.ttf",
      "Lora/Lora-VF.ttf",
      "Oswald/Oswald-VF.ttf",
      "Exo2/Exo2-VF.ttf",
      "Montserrat/Montserrat-VF.ttf"
    ],
    "source": "https://github.com/google/fonts (ofl/*), лицензия SIL OFL 1.1"
  },
  "env": {
    "file": ".env",
    "vars": [
      {
        "name": "FISH_API_KEY",
        "required_for": "voice",
        "hint": "ключ Fish Audio; нужен только с итерации голоса"
      }
    ]
  },
  "scopes": {
    "$comment": "npm run check проверяет scope 'base'+'render'. npm run check -- --scope voice добавляет голос.",
    "default": [
      "base",
      "render"
    ]
  },
  "render_env": {
    "$comment": "Необязательные переменные рендера, читает remotion.config.ts",
    "vars": [
      {
        "name": "REMOTION_GL",
        "default": "angle",
        "allowed": [
          "angle",
          "swangle",
          "egl",
          "swiftshader",
          "vulkan",
          "angle-egl"
        ],
        "hint": "Mac: angle (GPU). Linux без GPU: swangle"
      },
      {
        "name": "REMOTION_BROWSER_EXECUTABLE",
        "default": null,
        "hint": "путь к своему headless Chrome, если скачивание браузера Remotion недоступно"
      }
    ]
  }
}