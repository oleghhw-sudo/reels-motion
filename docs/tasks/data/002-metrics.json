  "phrases": [
    {
      "n": 1,
      "id": "hook",
      "text": "Погляд, який говорить більше.",
      "chars": 26,
      "words": 4
    },
    {
      "n": 2,
      "id": "numbers-words",
      "text": "Двадцять чотири години на добу, сім днів на тиждень.",
      "chars": 44,
      "words": 9
    },
    {
      "n": 3,
      "id": "apostrophe-dash",
      "text": "Об’єм, довжина й форма — індивідуально, без шаблону.",
      "chars": 45,
      "words": 7
    },
    {
      "n": 4,
      "id": "g-anglicisms",
      "text": "Ґрунтовний підхід: Claude Code, After Effects і Remotion в одному процесі.",
      "chars": 64,
      "words": 11
    },
    {
      "n": 5,
      "id": "long",
      "text": "Студія працює щодня з дев’ятої до двадцятої, а запис відкритий на тиждень уперед, тому оберіть зручний час заздалегідь.",
      "chars": 102,
      "words": 18
    },
    {
