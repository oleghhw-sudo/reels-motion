{
  "name": "reels-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Личная система моушн-дизайна для Reels на Remotion",
  "scripts": {
    "check": "node scripts/check-env.mjs",
    "check:self-test": "node scripts/check-env.mjs --self-test",
    "test:contrast": "node --experimental-strip-types src/theme/contrast.test.ts",
    "test:motion": "node --experimental-strip-types --no-warnings src/motion/test.ts",
    "test:countup": "node --experimental-strip-types src/elements/countup.test.ts",
    "readcheck": "node scripts/readcheck.mjs",
    "studio": "remotion studio src/index.ts",
    "still": "node scripts/still.mjs",
    "sfx:collect": "node sfx/collect.mjs",
    "sfx:lab": "node sfx/lab/serve.mjs",
    "mia:prepare": "node --experimental-strip-types --no-warnings videos/mia-outro/prepare-assets.mjs",
    "mia:zones": "node --experimental-strip-types --no-warnings videos/mia-outro/check-zones.mjs",
    "agent:prepare": "node videos/agent-terminal/prepare-assets.mjs",
    "test:agent": "node --experimental-strip-types --no-warnings src/videos/agent-terminal/numbers.test.ts",
    "matte": "node tools/matte/matte.mjs",
    "matte:sheet": "node tools/matte/sheet.mjs",
    "matte:calibrate": "node tools/matte/calibrate.mjs",
    "test:matte": "node --experimental-strip-types --no-warnings src/matte/matte.test.ts",
    "test:talking": "node --experimental-strip-types --no-warnings src/fx/talking/talking.test.ts"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.81",
    "@paper-design/shaders-react": "0.0.81",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@types/node": "22.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "fontkit": "2.0.4",
    "typescript": "5.9.3"
  }
}
